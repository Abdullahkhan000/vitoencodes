{
  "name": "vitoencodes-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/local-env.mjs --test tests/*.test.ts",
    "start:local": "node --env-file=.env.local --experimental-strip-types scripts/start-local.mjs",
    "check:tmdb": "node --env-file=.env.local --experimental-strip-types scripts/start-local.mjs --check",
    "db:migrate": "node --experimental-strip-types scripts/migrate-postgres.mjs",
    "db:import": "node --experimental-strip-types scripts/import-sqlite.mjs",
    "test:neon": "node --experimental-strip-types scripts/test-neon.mjs"
  },
  "dependencies": {
    "@neon/config": "1.9.5",
    "@neon/env": "^1.6.6",
    "@next/env": "^16.4.3",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "0.542.0",
    "next": "^16.4.3",
    "otpauth": "^9.5.2",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  }
}

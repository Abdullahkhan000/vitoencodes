ADMIN_TOKEN=
# OAuth client with Drive metadata read scope and access to the allowed folders.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional temporary alternative to refresh credentials:
GOOGLE_DRIVE_ACCESS_TOKEN=
# Comma-separated folder IDs. All nested subfolders are scanned; shortcuts are skipped.
DRIVE_FOLDER_IDS=
# Persistent filesystem directory (VPS / Docker volume):
DATA_DIRECTORY=./data
# Linkify Media: server-only credentials, never use NEXT_PUBLIC_ for this key.
LINKIFY_MEDIA_API_BASE=https://linkify-media.vercel.app
LINKIFY_MEDIA_API_KEY=
# Primary movie metadata provider. API credentials must remain server-only.
METADATA_PROVIDER=tmdb
TMDB_API_KEY=
# Optional alternative authentication: API Read Access Token (Bearer).
TMDB_READ_ACCESS_TOKEN=

# Server-only Neon URLs. Leave empty to use local SQLite.
# Manual setup: direct URL in DATABASE_URL, pooled URL in DATABASE_URL_POOLED.
# Neon CLI instead writes pooled DATABASE_URL + direct DATABASE_URL_UNPOOLED.
DATABASE_URL=
DATABASE_URL_POOLED=
DATABASE_URL_UNPOOLED=

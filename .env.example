ADMIN_TOKEN=
# OAuth client with Drive metadata read scope and access to the allowed folders.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional temporary alternative to refresh credentials:
GOOGLE_DRIVE_ACCESS_TOKEN=
# Comma-separated folder IDs. All nested subfolders are scanned; shortcuts are skipped.
DRIVE_FOLDER_IDS=
# Persistent filesystem directory (VPS / Docker volume):
DATA_DIRECTORY=./data
# Linkify Media: server-only credentials, never use NEXT_PUBLIC_ for this key.
LINKIFY_MEDIA_API_BASE=https://linkify-media.vercel.app
LINKIFY_MEDIA_API_KEY=
# Primary movie metadata provider. API credentials must remain server-only.
METADATA_PROVIDER=tmdb
TMDB_API_KEY=
# Optional alternative authentication: API Read Access Token (Bearer).
TMDB_READ_ACCESS_TOKEN=

# Server-only Neon URLs. Leave empty to use local SQLite.
# Manual setup: direct URL in DATABASE_URL, pooled URL in DATABASE_URL_POOLED.
# Neon CLI instead writes pooled DATABASE_URL + direct DATABASE_URL_UNPOOLED.
DATABASE_URL=
DATABASE_URL_POOLED=
DATABASE_URL_UNPOOLED=

# Cloudflare widget: allow your Vercel production hostname and custom domain.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional comma-separated allowed response hostnames (no protocol):
TURNSTILE_HOSTNAMES=
# Independent stable keys (32+ chars). Keep offline with backup files.
MFA_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
# Vercel daily cron authorization; 32+ random characters, server-only.
CRON_SECRET=
# Separate scheduled Drive import credential when admin MFA is enabled.
SYNC_TOKEN=
# Optional HTTPS webhook accepting {text,content}.
ALERT_WEBHOOK_URL=
# Set false to turn off aggregate movie/search/mirror counts.
ANALYTICS_ENABLED=true
# Canonical origin; change after adding your own domain.
SITE_URL=https://vitoencodes-ten.vercel.app
